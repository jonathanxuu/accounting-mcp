ACCOUNTING_MCP_AUTH_MODE=api_key
ACCOUNTING_MCP_API_KEY=replace-with-a-long-random-token
ACCOUNTING_MCP_USER_HEADER=x-accounting-user
# Restrict google_oauth mode to tokens minted by your own OAuth client(s).
# Without this, any valid Google access token is accepted, whoever issued it.
# GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=1234-abc.apps.googleusercontent.com,5678-def.apps.googleusercontent.com
# Optional extra allowlists. Leave unset to accept any Google account that
# passes the client id check above.
# GOOGLE_OAUTH_ALLOWED_DOMAINS=example.com
# GOOGLE_OAUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/accounting
PORT=4010
HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_SHEETS_SYNC_ENABLED=false
# Used as the detail tab name inside each MCP caller spreadsheet and as the file title prefix.
GOOGLE_SHEETS_SHEET_NAME=Expenses
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
